{
  "version": 2,
  "note": "Rule set for a salaried NZ employee, tuned against Ru's real ANZ statements (Aug 2025 - Jun 2026). Patterns are case-insensitive regex matched against the raw transaction description, and array order is the evaluation order: first match wins. Bank descriptors are truncated at a fixed width, so patterns are written against the truncated form where that is what actually lands - 'city counci', 'restaur', 'ice crea', '\\bcaf\\b'. The exclusions stay deliberately conservative, because under-excluding shows up as a visible transfer you can fix while over-excluding silently hides real spending. See README, 'Tuning the rules'.",
  "passthrough_in": [],
  "passthrough_out": [],
  "exclusions": [
    "payment received",
    "payment - thank you",
    "payment thankyou",
    "direct debit payment received",
    "^cc payment",
    "^credit card payment",
    "^payment to card",
    "^dd dishonour",
    "^ap dishonour",
    "^transfer from everyday"
  ],
  "unidentified": [
    "^trf \\*+ ?\\d*",
    "^trf \\d",
    "^eftpos$"
  ],
