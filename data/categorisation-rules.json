{
  "version": 1,
  "note": "Starter rule set for a salaried NZ employee. Patterns are case-insensitive regex matched against the raw transaction description, and array order is the evaluation order: first match wins. The merchant patterns cover the chains that show up on almost every NZ bank statement; the exclusions are deliberately conservative, because under-excluding shows up as a visible transfer you can fix while over-excluding silently hides real spending. Tune the exclusions against real statements once they are imported - see README, 'Tuning the rules'.",
  "passthrough_in": [],
  "passthrough_out": [],
  "exclusions": [
    "payment received",
    "payment - thank you",
    "payment thankyou",
    "direct debit payment received",
    "^cc payment",
    "^credit card payment",
    "^payment to card",
    "^dd dishonour",
    "^ap dishonour",
    "^transfer from everyday"
  ],
  "unidentified": [
    "^trf \\*+ ?\\d*",
    "^trf \\d",
    "^eftpos$"
  ],
