# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Postgres --------------------------------------------------------------
# Owner connection. Runs migrations and the seed scripts.
DATABASE_URL=postgresql://finance_owner:PASSWORD@postgres:5432/ruledger

# Optional least-privilege connections. Both fall back to DATABASE_URL when
# unset, which is fine locally. In Coolify, set them: finance_web cannot touch
# the ledger and finance_sync cannot touch rules or overrides.
# See db/migrations/0004_roles_and_grants.sql for how to grant them login.
DATABASE_URL_WEB=
DATABASE_URL_SYNC=

# TLS is off unless set. Leave empty when Postgres shares a private network with
# the app (the normal Coolify setup). Set to "require" whenever the connection
# leaves the host, or "no-verify" for a managed database with a self-signed
# certificate.
PGSSLMODE=

# --- Locking it ------------------------------------------------------------
# Set this and the whole app asks for a password. Leave it empty and the app is
# open to anyone who can reach it, which is fine on a laptop and is not fine on
# the internet.
#
# It is also the root credential: passkeys are registered from the Accounts page
# by someone already signed in, and changing this signs every device out. Long
# and boring beats short and clever; nothing has to type it more than once a
# month.
APP_PASSWORD=

# Only needed when one deployment answers on several hostnames and they should
# share passkeys. Set it to the registrable parent domain - ledger.example.com
# and www.ledger.example.com both work under example.com. Left empty, the host
# of the request is used, which is right for the normal single-domain setup.
#
# Passkeys need a secure context: https, or localhost. Over plain http on a LAN
# address the browser will refuse to make one, and the password is the way in.
WEBAUTHN_RP_ID=

# --- Akahu -----------------------------------------------------------------
# Personal App credentials from my.akahu.io.
# Sent as: Authorization: Bearer <AKAHU_USER_TOKEN>
AKAHU_USER_TOKEN=
# Sent as: X-Akahu-Id: <AKAHU_APP_ID_TOKEN>
AKAHU_APP_ID_TOKEN=
